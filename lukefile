luke_format = 0

package  = 'specl'
version  = '$USER'

-- A build without help2man keeps the man page that a release commits.
variables = {
   HELP2MAN = {checkprog='HELP2MAN', progs={'help2man', 'true'}},
}

ldocs    = 'build-aux/config.ld.in'

modules  = {
   {['specl.badargs']            = 'lib/specl/badargs.lua'},
   {['specl.color']              = 'lib/specl/color.lua'},
   {['specl.compat']             = 'lib/specl/compat.lua'},
   {['specl.expect']             = 'lib/specl/expect.lua'},
   {['specl.formatter.progress'] = 'lib/specl/formatter/progress.lua'},
   {['specl.formatter.report']   = 'lib/specl/formatter/report.lua'},
   {['specl.formatter.tap']      = 'lib/specl/formatter/tap.lua'},
   {['specl.inprocess']          = 'lib/specl/inprocess.lua'},
   {['specl.loader']             = 'lib/specl/loader.lua'},
   {['specl.main']               = 'lib/specl/main.lua'},
   {['specl.matchers']           = 'lib/specl/matchers.lua'},
   {['specl.runner']             = 'lib/specl/runner.lua'},
   {['specl.sandbox']            = 'lib/specl/sandbox.lua'},
   {['specl.shell']              = 'lib/specl/shell.lua'},
   {['specl.std']                = 'lib/specl/std.lua'},
   {['specl.util']               = 'lib/specl/util.lua'},
   {['specl.version']            = 'lib/specl/version.lua.in'},
}

install  = {
   bin = {
      {specl = 'bin/specl'},
   },
}

-- ./specl runs bin/specl with the modules in this source tree.
bin      = {
   'specl.in',
}

files    = {
   {['doc/specl.1'] = {
      command = '$HELP2MAN --output=$target --no-info --name=Specl ./specl',
      sources = 'specl.in',
   }},
}

-- `luke release version=X.Y` adds the release to NEWS.md, writes the
-- release rockspec, points the README badges at the release branch,
-- commits the LDocs and man page, and publishes the manual and LDocs
-- to gh-pages.
release  = {
   news         = 'NEWS.md',
   rockspec     = 'specl-dev-1.rockspec',
   add          = {'doc/api/'},
   replacements = {
      {['README.md'] = {
         {['?branch=master'] = '?branch=release-v@version@'},
      }},
   },
   ['gh-pages'] = {
      {api          = 'doc/api/'},
      {['index.md'] = 'doc/specl.md'},
      '_config.yml.in',
   },
}
